---
import { CompareTool } from "../components/CompareTool";
import Layout from "../layouts/Layout.astro";
import { getAllFonts } from "../lib/db/queries";

const fonts = await getAllFonts();
---

<Layout
  title="比較字體"
  description="使用自訂預覽文字並排比較開源中日韓字體。"
>
  <section class="px-4 py-8">
    <div class="mb-6 max-w-3xl">
      <p class="text-sm font-semibold text-vermilion">工作台</p>
      <h1 class="mt-2 text-3xl font-semibold">比較字體</h1>
      <p class="mt-3 leading-7 text-base-content/70">
        使用同一段文字與字級檢查多款字體。加入或移除字體時，檢視區會保持相同條件。
      </p>
    </div>
    <CompareTool client:load fonts={fonts} />
  </section>
</Layout>
