---
import { CompareTool } from "../components/CompareTool";
import Layout from "../layouts/Layout.astro";
import { getAllFonts } from "../lib/db/queries";

const fonts = await getAllFonts();
---

<Layout
  title="Compare Fonts"
  description="Compare open-source CJK fonts side by side with custom preview text."
>
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="mb-8">
      <h1 class="text-4xl font-semibold text-ink-900 dark:text-ink-50">
        Compare Fonts
      </h1>
      <p class="mt-3 max-w-2xl text-ink-700 dark:text-ink-100">
        Select multiple catalog fonts and compare their CJK texture with the same sample text.
      </p>
    </div>
    <CompareTool client:load fonts={fonts} />
  </section>
</Layout>
