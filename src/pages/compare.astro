---
import CompareTool from "../components/CompareTool";
import Layout from "../layouts/Layout.astro";
import { getAllFonts } from "../lib/db/queries";

const fonts = await getAllFonts();
---

<Layout title="比較字體" description="並排比較多款中日韓開源字體的預覽文字與基本資訊。">
  <section class="container mx-auto grid gap-6 px-4 py-8">
    <div class="grid gap-2">
      <h1 class="text-2xl font-semibold">比較字體</h1>
      <p class="max-w-3xl cjk-copy text-base opacity-80">
        選取常用候選字體，使用同一段文字檢查筆畫密度、比例與閱讀節奏。
      </p>
    </div>
    <CompareTool fonts={fonts} client:load />
  </section>
</Layout>
