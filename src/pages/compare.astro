---
import { CompareTool } from "../components/CompareTool";
import Layout from "../layouts/Layout.astro";
import { getAllFonts } from "../lib/db/queries";

const fonts = await getAllFonts();
---

<Layout
  title="比較字體"
  description="使用自訂預覽文字並排比較開源中日韓字體。"
>
  <section class="container mx-auto px-4 py-10">
    <div class="mb-8 max-w-3xl">
      <p class="text-sm font-semibold text-primary">字體比較</p>
      <h1 class="mt-3 text-4xl font-semibold">
        比較字體
      </h1>
      <p class="mt-3 text-base-content/70">
        選擇多款目錄字體，使用相同範例文字比較中日韓字形質感。
      </p>
    </div>
    <CompareTool client:load fonts={fonts} />
  </section>
</Layout>
