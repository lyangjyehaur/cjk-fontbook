---
import { Badge } from "../../components/Badge";
import { FontPreview } from "../../components/FontPreview";
import Layout from "../../layouts/Layout.astro";
import { getAllFonts, getFontBySlug } from "../../lib/db/queries";
import { GLYPH_LABELS } from "../../lib/catalog";

export async function getStaticPaths() {
  const fonts = await getAllFonts();
  return fonts.map((font) => ({
    params: { slug: font.slug },
  }));
}

const font = await getFontBySlug(Astro.params.slug ?? "");

if (!font) {
  return Astro.redirect("/");
}

const description =
  font.description ?? `${font.name} 收錄於 CJK Fontbook 開源字體目錄。`;
const links = [
  { label: "來源", href: font.sourceUrl },
  { label: "程式庫", href: font.repoUrl },
  { label: "官方網站", href: font.homepageUrl },
].filter((link): link is { label: string; href: string } => Boolean(link.href));
const cssUsage = font.previewCssUrl
  ? [
      `@import url("${font.previewCssUrl}");`,
      "",
      ".example {",
      `  font-family: ${font.cssFontFamily ?? `"${font.name}", sans-serif`};`,
      "}",
    ]
  : [
      ".example {",
      `  font-family: ${font.cssFontFamily ?? `"${font.name}", sans-serif`};`,
      "}",
    ];
const categoryLabels: Record<string, string> = {
  sans: "無襯線",
  serif: "襯線",
  rounded: "圓體",
  mono: "等寬",
  handwriting: "手寫",
  pixel: "點陣",
};
const coverageLabels: Record<string, string> = {
  full: "完整",
  partial: "部分",
  experimental: "實驗",
  none: "無",
};
---

<Layout title={font.name} description={description} ogType="article">
  <article>
    <section class="hero bg-base-100">
      <div class="hero-content container mx-auto grid gap-8 px-4 py-12 lg:grid-cols-[minmax(0,1fr)_22rem]">
        <div>
          <p class="text-sm font-semibold text-primary">字體詳情</p>
          <h1 class="mt-4 text-5xl font-semibold tracking-normal">
            {font.name}
          </h1>
          {font.displayName && font.displayName !== font.name ? (
            <p class="mt-3 text-2xl text-base-content/70">
              {font.displayName}
            </p>
          ) : null}
          <p class="mt-5 max-w-3xl text-lg leading-8 text-base-content/70">
            {description}
          </p>
        </div>
        <aside class="card border border-base-300 bg-base-200 shadow-sm">
          <div class="card-body gap-4">
            <h2 class="card-title text-lg">中繼資料</h2>
            <div class="stats stats-vertical bg-base-100 shadow-none">
              <div class="stat px-4 py-3">
                <div class="stat-title">授權</div>
                <div class="stat-value text-lg">{font.license}</div>
              </div>
              <div class="stat px-4 py-3">
                <div class="stat-title">作者</div>
                <div class="stat-value text-lg">{font.author ?? "未知"}</div>
              </div>
              <div class="stat px-4 py-3">
                <div class="stat-title">可變字重</div>
                <div class="stat-value text-lg">{font.isVariable ? "是" : "否"}</div>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <div class="container mx-auto px-4 py-8">
    <section class="flex flex-wrap gap-2" aria-label="字體中繼資料">
      <Badge tone="category">{categoryLabels[font.category] ?? font.category}</Badge>
      <Badge tone="license">{font.license}</Badge>
      {font.languages.map((language) => (
        <Badge tone="language">{GLYPH_LABELS[language.languageCode]} {coverageLabels[language.coverageLevel] ?? language.coverageLevel}</Badge>
      ))}
      {font.isSourceHanDerivative ? (
        <Badge tone="language">思源系</Badge>
      ) : null}
      {font.tags.map((tag) => (
        <Badge>{tag}</Badge>
      ))}
    </section>

    <section class="mt-10" aria-labelledby="preview-heading">
      <h2 id="preview-heading" class="mb-4 text-2xl font-semibold">
        預覽
      </h2>
      <FontPreview client:load font={font} loadOnMount showDetailLink={false} />
    </section>

    <section class="mt-10 grid gap-6 lg:grid-cols-2">
      <div class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body">
        <h2 class="card-title text-xl">
          連結
        </h2>
        {links.length > 0 ? (
          <div class="mt-2 grid gap-2">
            {links.map((link) => (
              <a class="btn btn-outline justify-start" href={link.href}>
                <span class="font-medium">{link.label}</span>
                <span class="truncate text-xs font-normal opacity-65">{link.href}</span>
              </a>
            ))}
          </div>
        ) : (
          <p class="text-sm text-base-content/60">尚未提供外部連結。</p>
        )}
        </div>
      </div>

      <div class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body">
        <h2 class="card-title text-xl">
          CSS 用法
        </h2>
        <div class="mockup-code mt-2 text-sm">
          {cssUsage.map((line, index) => (
            <pre data-prefix={line ? index + 1 : ""}><code>{line}</code></pre>
          ))}
        </div>
        </div>
      </div>
    </section>

    {font.notes ? (
      <section class="alert alert-info mt-6">
        <div>
          <h2 class="font-semibold">注意事項</h2>
          <p class="mt-1 leading-7">{font.notes}</p>
        </div>
      </section>
    ) : null}
    </div>
  </article>
</Layout>
