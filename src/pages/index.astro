---
import { FontFilterPanel } from "../components/FontFilterPanel";
import Layout from "../layouts/Layout.astro";
import { getAllFonts } from "../lib/db/queries";

const fonts = await getAllFonts();
---

<Layout>
  <section class="hero bg-base-100">
    <div class="hero-content container mx-auto flex-col px-4 py-14 text-center lg:py-16">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold text-primary">開源中日韓字體</p>
        <h1 class="mt-4 text-5xl font-semibold tracking-normal sm:text-6xl">
          CJK Fontbook
        </h1>
        <p class="mt-5 text-lg leading-8 text-base-content/70">
          探索開源中文字體、日文字體與韓文字體。快速篩選、預覽與比較適合專案的開源字型。
        </p>
      </div>
    </div>
  </section>

  <section class="container mx-auto px-4 py-8">
    <FontFilterPanel client:load fonts={fonts} />
  </section>
</Layout>
