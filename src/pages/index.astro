---
import FontFilterPanel from "../components/FontFilterPanel";
import Layout from "../layouts/Layout.astro";
import { getAllFonts } from "../lib/db/queries";

const fonts = await getAllFonts();
---

<Layout title="字體目錄" description="瀏覽、篩選並預覽開源中日韓字體。">
  <section class="container mx-auto grid gap-6 px-4 py-8">
    <div class="grid gap-2">
      <h1 class="text-2xl font-semibold">字體目錄</h1>
      <p class="max-w-3xl cjk-copy text-base opacity-80">
        探索開源中文字體、日文字體與韓文字體。依字形區別、分類、授權與思源系來源快速縮小清單。
      </p>
    </div>
    <FontFilterPanel fonts={fonts} client:load />
  </section>
</Layout>
