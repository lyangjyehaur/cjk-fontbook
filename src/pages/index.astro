---
import { FontFilterPanel } from "../components/FontFilterPanel";
import Layout from "../layouts/Layout.astro";
import { getAllFonts } from "../lib/db/queries";

const fonts = await getAllFonts();
---

<Layout>
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="grid gap-8 lg:grid-cols-[1fr_420px] lg:items-end">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-vermilion">
          Open-source CJK typography
        </p>
        <h1 class="mt-4 max-w-4xl text-5xl font-semibold tracking-normal text-ink-900 dark:text-ink-50 sm:text-6xl">
          CJK Fontbook
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-ink-700 dark:text-ink-100">
          Discover open-source fonts for Chinese, Japanese and Korean.
        </p>
      </div>
      <div class="rounded-lg border border-ink-200 bg-white/78 p-5 shadow-sm dark:border-white/10 dark:bg-white/[0.06]">
        <p class="text-sm font-medium text-ink-700 dark:text-ink-100">
          Preview sample
        </p>
        <p class="mt-3 text-4xl leading-tight text-ink-900 dark:text-ink-50">
          字体見本 한글
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <FontFilterPanel client:load fonts={fonts} />
  </section>
</Layout>
