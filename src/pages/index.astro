---
import { FontFilterPanel } from "../components/FontFilterPanel";
import Layout from "../layouts/Layout.astro";
import { getAllFonts } from "../lib/db/queries";

const fonts = await getAllFonts();
---

<Layout>
  <section class="px-4 py-8">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold text-vermilion">開源中日韓字體</p>
      <h1 class="mt-2 text-3xl font-semibold">字體目錄</h1>
      <p class="mt-3 max-w-2xl leading-7 text-base-content/70">
        以字形區別、分類與授權縮小清單，展開列內預覽後再進入詳情或比較。
      </p>
    </div>
  </section>

  <section class="px-4 pb-10">
    <FontFilterPanel client:load fonts={fonts} />
  </section>
</Layout>
