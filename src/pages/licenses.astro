---
import { Badge } from "../components/Badge";
import Layout from "../layouts/Layout.astro";
import { getLicenseGroups } from "../lib/db/queries";
import { GLYPH_LABELS } from "../lib/catalog";

const licenseGroups = await getLicenseGroups();
const categoryLabels: Record<string, string> = {
  sans: "無襯線",
  serif: "襯線",
  rounded: "圓體",
  mono: "等寬",
  handwriting: "手寫",
  pixel: "點陣",
};
---

<Layout
  title="授權條款"
  description="CJK Fontbook 目錄中收錄字體的開源授權。"
>
  <section class="container mx-auto max-w-5xl px-4 py-10">
    <p class="text-sm font-semibold text-primary">授權索引</p>
    <h1 class="mt-3 text-4xl font-semibold">
      授權條款
    </h1>
    <p class="mt-3 max-w-2xl text-base-content/70">
      授權摘要僅作為目錄索引，不構成法律建議。正式使用字體前，請務必檢閱上游字體專案。
    </p>

    <div class="mt-8 space-y-4">
      {licenseGroups.map((group, index) => (
        <div class="collapse collapse-arrow border border-base-300 bg-base-100 shadow-sm">
          <input type="checkbox" checked={index === 0} />
          <div class="collapse-title flex flex-wrap items-center gap-3 text-xl font-semibold">
            <span>{group.license}</span>
            <Badge tone="license">{group.fonts.length} 個字體</Badge>
          </div>
          <div class="collapse-content">
            <ul class="grid gap-3 pt-2 sm:grid-cols-2">
              {group.fonts.map((font) => (
                <li>
                  <a
                    class="block rounded-box border border-base-300 bg-base-200 p-4 transition hover:border-primary hover:bg-base-100"
                    href={`/fonts/${font.slug}/`}
                  >
                    <span class="block font-medium">{font.name}</span>
                    <span class="mt-1 block text-sm text-base-content/60">
                      {categoryLabels[font.category] ?? font.category} · {font.languages.map((language) => GLYPH_LABELS[language.languageCode]).join(", ")}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
