---
const navItems = [
  { href: "/", label: "目錄" },
  { href: "/compare/", label: "比較" },
  { href: "/licenses/", label: "授權" },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-30 border-b border-base-300 bg-base-100/95 backdrop-blur">
  <div class="container mx-auto px-4">
    <div class="navbar min-h-14 px-0">
      <div class="navbar-start">
        <a href="/" class="btn btn-ghost px-2 text-base font-semibold">
          CJK Fontbook
        </a>
      </div>
      <nav class="navbar-end" aria-label="主要導覽">
        <ul class="menu menu-horizontal gap-1 px-0">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class={currentPath === item.href ? "active" : ""}
                aria-current={currentPath === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</header>
