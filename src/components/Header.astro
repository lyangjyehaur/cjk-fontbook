---
const navItems = [
  { href: "/", label: "Catalog" },
  { href: "/compare/", label: "Compare" },
  { href: "/licenses/", label: "Licenses" },
];
---

<header class="border-b border-ink-200/80 bg-ink-50/80 backdrop-blur dark:border-white/10 dark:bg-ink-900/80">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-4 sm:px-6 lg:px-8" aria-label="Primary">
    <a class="text-base font-semibold text-ink-900 dark:text-ink-50" href="/">
      CJK Fontbook
    </a>
    <div class="flex items-center gap-1">
      {navItems.map((item) => (
        <a
          class="rounded-full px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-white hover:text-vermilion dark:text-ink-100 dark:hover:bg-white/10"
          href={item.href}
        >
          {item.label}
        </a>
      ))}
    </div>
  </nav>
</header>
