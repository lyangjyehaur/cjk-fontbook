---
const navItems = [
  { href: "/", label: "目錄" },
  { href: "/compare/", label: "比較" },
  { href: "/licenses/", label: "授權" },
];
---

<header class="sticky top-0 z-30 border-b border-base-300 bg-base-100/95 backdrop-blur">
  <nav class="navbar min-h-14 px-4" aria-label="主要導覽">
    <div class="navbar-start">
      <a class="btn btn-ghost btn-sm px-2 text-base font-semibold" href="/">
        CJK Fontbook
      </a>
    </div>
    <div class="navbar-end gap-1">
      {navItems.map((item) => (
        <a
          class="btn btn-ghost btn-sm"
          href={item.href}
        >
          {item.label}
        </a>
      ))}
    </div>
  </nav>
</header>
