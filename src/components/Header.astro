---
const navItems = [
  { href: "/", label: "目錄" },
  { href: "/compare/", label: "比較" },
  { href: "/licenses/", label: "授權" },
];
---

<header class="border-b border-base-300/80 bg-base-100/90 backdrop-blur">
  <nav class="navbar mx-auto max-w-7xl px-4 sm:px-6 lg:px-8" aria-label="主要導覽">
    <div class="flex-1">
      <a class="btn btn-ghost px-2 text-base font-semibold text-ink-900 hover:text-vermilion dark:text-ink-50" href="/">
      CJK Fontbook
      </a>
    </div>
    <div class="flex-none">
      {navItems.map((item) => (
        <a
          class="btn btn-ghost btn-sm text-ink-700 hover:text-vermilion dark:text-ink-100"
          href={item.href}
        >
          {item.label}
        </a>
      ))}
    </div>
  </nav>
</header>
