---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "CJK Fontbook",
  description = "CJK Fontbook 收錄開源中日韓字體，提供篩選、預覽、比較與授權資訊。",
} = Astro.props;

const pageTitle = title === "CJK Fontbook" ? title : `${title} · CJK Fontbook`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://fontbook.dan.tw");
---

<!doctype html>
<html lang="zh-Hant" data-theme="winter">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CJK Fontbook" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      const applyTheme = () => {
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = prefersDark ? "night" : "winter";
      };
      applyTheme();
      window
        .matchMedia("(prefers-color-scheme: dark)")
        .addEventListener("change", applyTheme);
    </script>
  </head>
  <body class="min-h-screen bg-base-200 text-base-content">
    <a class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:btn focus:btn-primary" href="#main-content">
      跳到主要內容
    </a>
    <Header />
    <main id="main-content" class="min-h-[calc(100vh-8rem)]">
      <slot />
    </main>
    <Footer />
    <script src="https://font.emtech.cc/emfont.js"></script>
    <script is:inline>
      window.emfont?.init?.();
    </script>
  </body>
</html>
