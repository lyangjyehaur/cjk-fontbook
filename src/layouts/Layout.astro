---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

interface Props {
  title?: string;
  description?: string;
  schemaOrg?: Record<string, unknown>;
}

const {
  title = "CJK Fontbook",
  description = "CJK Fontbook 收錄開源中日韓字體，提供篩選、預覽、比較與授權資訊。",
  schemaOrg,
} = Astro.props;

const pageTitle = title === "CJK Fontbook" ? title : `${title} · CJK Fontbook`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://fontbook.dan.tw");
const defaultSchemaOrg =
  Astro.url.pathname === "/"
    ? {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "CJK Fontbook",
        url: "https://fontbook.dan.tw",
        description: "探索開源中文字體、日文字體與韓文字體。",
      }
    : undefined;
const jsonLd = schemaOrg ?? defaultSchemaOrg;
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, "\\u003c") : undefined;
---

<!doctype html>
<html lang="zh-Hant" data-theme="winter">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CJK Fontbook" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://fontbook.dan.tw/og-image.png" />
    <meta name="twitter:card" content="summary" />
    <link rel="sitemap" href="/sitemap.xml" />
    {jsonLdText ? <script is:inline type="application/ld+json" set:html={jsonLdText} /> : null}
    <script is:inline>
      const applyTheme = () => {
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = prefersDark ? "night" : "winter";
      };
      applyTheme();
      window
        .matchMedia("(prefers-color-scheme: dark)")
        .addEventListener("change", applyTheme);
    </script>
  </head>
  <body class="min-h-screen bg-base-200 text-base-content">
    <a class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:btn focus:btn-primary" href="#main-content">
      跳到主要內容
    </a>
    <Header />
    <main id="main-content" class="min-h-[calc(100vh-8rem)]">
      <slot />
    </main>
    <Footer />
    <script src="https://font.emtech.cc/emfont.js"></script>
    <script is:inline>
      window.emfont?.init?.();
    </script>
  </body>
</html>
