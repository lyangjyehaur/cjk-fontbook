---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
}

const {
  title = "CJK Fontbook",
  description = "探索開源中文字體、日文字體與韓文字體。",
  ogType = "website",
} = Astro.props;
const pageTitle = title === "CJK Fontbook" ? title : `${title} | CJK Fontbook`;
---

<!doctype html>
<html lang="zh-Hant" data-theme="winter">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="CJK Fontbook" />
    <meta property="og:url" content={Astro.url.href} />
    <script is:inline>
      const applyTheme = () => {
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.setAttribute("data-theme", prefersDark ? "night" : "winter");
      };
      applyTheme();
      window
        .matchMedia("(prefers-color-scheme: dark)")
        .addEventListener("change", applyTheme);
    </script>
  </head>
  <body class="min-h-screen bg-base-200 font-sans text-base-content antialiased">
    <Header />
    <main class="min-h-[calc(100vh-9rem)]">
      <slot />
    </main>
    <Footer />
  </body>
</html>
